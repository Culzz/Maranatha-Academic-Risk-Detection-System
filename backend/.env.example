# Backend environment — copy to backend/.env and fill in the required values.
#   cp .env.example .env

# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/maranatha_risk_db

# JWT signing + Fernet encryption. Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# ── Common optional settings ───────────────────────────────────────────────
# Redis (cache, Celery broker, pub/sub)
REDIS_URL=redis://localhost:6379/0

# Debug mode (true/false)
DEBUG=true

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend base URL (used in email confirmation links)
FRONTEND_URL=http://localhost:5173

# HMAC secret for attendance QR codes. Generate the same way as SECRET_KEY.
QR_HMAC_SECRET=change-me

# ── Optional integrations ──────────────────────────────────────────────────
# AI tutoring layer (Claude). Leave blank to run without AI features.
ANTHROPIC_API_KEY=

# Observability
SENTRY_DSN=
METRICS_TOKEN=

# Web push notifications (VAPID). Generate:
#   python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.private_key_urlsafe, v.public_key_urlsafe)"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@example.com

# Email (SMTP) — leave blank to disable email sending
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# SMS (Termii) — leave blank to disable SMS sending
TERMII_API_KEY=
TERMII_SENDER_ID=Maranatha
