[Unit]
Description=Maranatha Celery Beat Scheduler
After=network.target redis.service

[Service]
User=maranatha
WorkingDirectory=/opt/maranatha_risk_system/backend
ExecStart=/opt/venv/bin/celery -A celery_app beat -l info
Restart=always
RestartSec=5
Environment="PYTHONPATH=/opt/maranatha_risk_system/backend"

[Install]
WantedBy=multi-user.target
