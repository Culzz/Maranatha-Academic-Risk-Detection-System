# Normalise line endings across platforms
* text=auto

# Shell scripts must stay LF — they run inside Linux containers
*.sh text eol=lf

# Common text types
*.py text
*.md text
*.txt text
*.json text
*.yml text
*.yaml text
*.sql text
*.jsx text
*.js text
*.css text
*.html text

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.svg text
*.joblib binary
*.pdf binary
