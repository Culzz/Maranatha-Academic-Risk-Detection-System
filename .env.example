# Docker Compose configuration — copy to .env and fill in.
# scripts/start.sh and scripts/start.ps1 generate this file for you automatically.

# Postgres password for the bundled db container
DB_PASSWORD=change-this

# JWT signing + Fernet encryption. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this

# HMAC secret for attendance QR codes. Generate the same way as SECRET_KEY.
QR_HMAC_SECRET=change-this

# Host port the web app is served on (use 8080 if port 80 is taken)
WEB_PORT=80

# Public/base URL of the app — set to your tunnel URL when sharing externally
FRONTEND_URL=http://localhost
CORS_ORIGINS=http://localhost,http://localhost:80

# Optional — AI assistant features
ANTHROPIC_API_KEY=

# Optional — browser push notifications
# Generate: python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.private_key_urlsafe, v.public_key_urlsafe)"
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@maranatha.edu.ng
